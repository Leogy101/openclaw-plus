{
  "name": "openclaw-plus-desktop",
  "productName": "OpenClaw+",
  "version": "0.8.0-preview.1",
  "private": true,
  "description": "An independent macOS workspace for an existing OpenClaw installation",
  "main": "src/main.cjs",
  "author": "OpenClaw+ contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
